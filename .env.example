# PostgreSQL. `pnpm run setup` starts the bundled docker-compose database when this is unreachable.
DATABASE_URL=postgres://audivra:audivra@127.0.0.1:5440/audivra
TEST_DATABASE_URL=postgres://audivra:audivra@127.0.0.1:5440/audivra_test

# Ports
SERVER_PORT=4310
WEB_PORT=4300

# AI runtime. "claude" uses the locally installed Claude Code CLI; "off" runs baseline-only audits.
AUDIVRA_AI=claude
# Leave model empty to use your Claude Code default model.
AUDITOR_MODEL=
AUDITOR_EFFORT=high
REVIEWER_MODEL=
REVIEWER_EFFORT=high
FINALIZER_MODEL=
FINALIZER_EFFORT=medium
PRESENTER_MODEL=
PRESENTER_EFFORT=medium
AUDITOR_TIMEOUT_MINUTES=60
AUDITOR_MAX_TURNS=400
# Safety ceilings for one AI investigation run; when one is reached the agent is asked to write up.
AUDITOR_MAX_BROWSER_ACTIONS=300
AUDITOR_MAX_COMMANDS=200
AUDITOR_MAX_TOOL_CALLS=600
AUDIT_MAX_REVISIONS=1

# Baseline limits
BASELINE_MAX_PAGES=30
BASELINE_MAX_LINK_CHECKS=200
BASELINE_BROWSER_PAGES=4
# Optional baseline scanners (comma-separated; empty disables all): httpx, katana, pa11y, zap, testssl.
# ZAP (passive baseline) and testssl.sh run in Docker (`pnpm run setup` pulls the images).
BASELINE_SCANNERS=httpx,katana,pa11y,zap,testssl

# Credential/session vault (Phase 5). The active AES-256-GCM key for encrypting authorized test
# credentials at rest, as base64 or hex for 32 bytes — e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# Keep it OUTSIDE the database and out of version control; set it from a real secrets source in production.
# Leave empty in local development: a dev key is generated once at .local-data/security/.vault-key.json
# (git-ignored) and reused, so stored secrets stay recoverable. NEVER commit a real key or that file.
AUDIVRA_SECRET_KEY=
# Optional: path to a JSON keyring file ({ "active": "<id>", "keys": { "<id>": "<base64>" } }) for rotation.
AUDIVRA_SECRET_KEY_FILE=

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
